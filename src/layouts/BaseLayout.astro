---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: { src: string; width?: number; height?: number };
	type?: 'website' | 'article';
	article?: {
		publishedTime: string;
		updatedTime?: string;
		author: string;
		tags?: string[];
	};
	jsonLd?: Record<string, unknown>;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	type,
	article,
	jsonLd,
} = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			pageTitle={pageTitle}
			description={description}
			image={image}
			type={type}
			article={article}
			jsonLd={jsonLd}
		/>
	</head>
	<body class="flex min-h-screen flex-col font-sans text-slate-300 antialiased">
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
			<div class="bg-grid absolute inset-0"></div>
			<div
				class="absolute left-1/2 top-0 h-[420px] w-[900px] max-w-full -translate-x-1/2 -translate-y-1/3 rounded-full bg-accent/10 blur-[140px]"
			>
			</div>
		</div>
		<Header />
		<main class="relative mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6 lg:px-8">
			<slot />
		</main>
		<Footer />
		<SearchDialog />
	</body>
</html>