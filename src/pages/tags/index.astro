---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPublishedPosts } from '../../utils/posts';
import { withBase } from '../../utils/url';

const tags = collectTags(await getPublishedPosts());
---

<BaseLayout title="标签" description="按标签浏览全部文章">
	<header class="border-b border-edge pb-8">
		<p class="font-mono text-sm text-accent">// tags</p>
		<h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">标签</h1>
		<p class="mt-3 font-mono text-sm text-slate-500">
			<span class="text-accent">$</span> grep -o '#[^ ]*' posts/*.md | sort | uniq -c
			<span class="mx-2 text-slate-600">→</span>
			{tags.length} 个
		</p>
	</header>
	{
		tags.length === 0 ? (
			<p class="mt-8 font-mono text-sm text-slate-500">// 还没有标签，去文章 frontmatter 里加 tags 吧</p>
		) : (
			<ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{tags.map(({ tag, count }) => (
					<li>
						<a
							href={withBase(`/tags/${encodeURIComponent(tag)}/`)}
							class="group flex items-center justify-between rounded-lg border border-edge bg-panel/40 px-4 py-3 font-mono text-sm text-slate-300 no-underline transition-colors hover:border-accent/40 hover:text-accent"
						>
							<span>#{tag}</span>
							<span class="text-xs text-slate-600 group-hover:text-slate-400">{count}</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>