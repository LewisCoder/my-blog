---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, type BlogPost } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

	return tags.map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts.filter((post) => post.data.tags.includes(tag)),
		},
	}));
}

interface Props {
	tag: string;
	posts: BlogPost[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的全部文章`}>
	<header class="border-b border-edge pb-8">
		<a
			href={withBase('/tags/')}
			class="font-mono text-xs text-slate-500 no-underline transition-colors hover:text-accent"
		>
			$ cd ../tags
		</a>
		<p class="mt-5 font-mono text-sm text-accent">// tag</p>
		<h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">#{tag}</h1>
		<p class="mt-3 font-mono text-sm text-slate-500">
			<span class="text-accent">$</span> ls ./posts | grep '#{tag}'
			<span class="mx-2 text-slate-600">→</span>
			{posts.length} 篇
		</p>
	</header>
	<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
		{posts.map((post, i) => <PostCard post={post} index={i + 1} />)}
	</div>
</BaseLayout>