---
import PostCard from '../components/PostCard.astro';
import TerminalCard from '../components/TerminalCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_ROLE, SITE_TITLE } from '../consts';
import { getHomeStats, getLatestPosts, getPopularTopics } from '../utils/home';
import { getPublishedPosts } from '../utils/posts';
import { withBase } from '../utils/url';

const allPosts = await getPublishedPosts();
const stats = getHomeStats(allPosts);
const latestPosts = getLatestPosts(allPosts, 3);
const topics = getPopularTopics(allPosts, 8);
const maxTopicCount = topics[0]?.count ?? 1;

const stack = [
	{ key: 'astro', label: '静态构建', detail: '内容集合与路由在构建期生成' },
	{ key: 'tailwind', label: '终端界面', detail: '统一的深色终端视觉' },
	{ key: 'markdown', label: '文章即文件', detail: '写作与版本管理保持简单' },
	{ key: 'local-search', label: '本地搜索', detail: '构建期索引，浏览器内匹配' },
];
---

<BaseLayout>
	<section class="grid items-center gap-12 py-10 sm:py-16 lg:grid-cols-[1.1fr_1fr]">
		<div>
			<p class="font-mono text-sm text-accent">// hello, world</p>
			<h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl">
				记录学习、
				<span
					class="bg-gradient-to-r from-emerald-300 via-teal-200 to-cyan-300 bg-clip-text text-transparent"
				>
					技术与生活
				</span>
			</h1>
			<p class="mt-4 font-mono text-sm text-slate-500">
				{SITE_TITLE} <span class="text-slate-600">// {SITE_ROLE} · 代码 / 系统 / 思考</span>
			</p>
			<p class="mt-6 max-w-xl text-lg leading-8 text-slate-400">
				把代码、系统设计与日常思考整理成可以检索、订阅和慢慢阅读的文字。
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a
					href={withBase('/blog/')}
					class="rounded-lg bg-accent px-5 py-2.5 font-mono text-sm font-semibold text-night no-underline shadow-[0_0_24px_-6px_rgba(52,211,153,0.6)] transition hover:bg-emerald-300"
				>
					阅读全部文章 →
				</a>
				<a
					href={withBase('/about/')}
					class="rounded-lg border border-edge px-5 py-2.5 font-mono text-sm text-slate-300 no-underline transition hover:border-accent/40 hover:text-accent"
				>
					关于本站
				</a>
			</div>
			<ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-mono text-xs text-slate-500">
				<li><span class="text-accent">{stats.postCount}</span> posts</li>
				<li><span class="text-accent">{stats.tagCount}</span> topics</li>
				<li><span class="text-accent">{stats.readingMinutes}</span> min reading</li>
				<li><span class="text-slate-300">0</span> database</li>
			</ul>
		</div>
		<TerminalCard />
	</section>

	<section class="mt-8 sm:mt-14">
		<div class="flex items-end justify-between border-b border-edge pb-4">
			<h2 class="font-mono text-sm text-slate-400">
				<span class="text-accent">##</span> latest_posts
			</h2>
			<a
				href={withBase('/blog/')}
				class="font-mono text-xs text-slate-500 no-underline transition-colors hover:text-accent"
			>
				view_all →
			</a>
		</div>
		<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{latestPosts.map((post, i) => <PostCard post={post} index={i + 1} />)}
		</div>
	</section>

	<section class="mt-12 grid gap-6 lg:grid-cols-[1.35fr_1fr]">
		<div class="rounded-xl border border-edge bg-panel/40 p-6 backdrop-blur">
			<div class="flex items-end justify-between gap-4 border-b border-edge pb-3">
				<h2 class="font-mono text-sm text-slate-400">
					<span class="text-accent">##</span> topics
				</h2>
				<a
					href={withBase('/tags/')}
					class="font-mono text-xs text-slate-500 no-underline transition-colors hover:text-accent"
				>
					browse_all →
				</a>
			</div>
			{
				topics.length > 0 ? (
					<ul class="mt-5 grid gap-3 sm:grid-cols-2">
						{topics.map(({ tag, count }) => (
							<li>
								<a
									href={withBase(`/tags/${encodeURIComponent(tag)}/`)}
									class="group flex items-center justify-between gap-3 rounded-lg border border-edge/70 bg-night/40 px-3.5 py-2.5 font-mono text-sm text-slate-300 no-underline transition-colors hover:border-accent/40 hover:text-accent"
								>
									<span class="min-w-0 truncate">
										<span class="text-slate-600">#</span>
										{tag}
									</span>
									<span class="flex shrink-0 items-center gap-2">
										<span class="h-1 w-10 overflow-hidden rounded-full bg-edge" aria-hidden="true">
											<span
												class="block h-full rounded-full bg-accent/70"
												style={`width: ${Math.round((count / maxTopicCount) * 100)}%`}
											/>
										</span>
										<span class="w-5 text-right text-[11px] text-slate-600 group-hover:text-slate-400">
											{count}
										</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="mt-5 font-mono text-sm text-slate-500">
						// 还没有标签，去文章 frontmatter 里加 tags 吧
					</p>
				)
			}
		</div>

		<div class="rounded-xl border border-edge bg-panel/40 p-6 backdrop-blur">
			<div class="border-b border-edge pb-3">
				<h2 class="font-mono text-sm text-slate-400">
					<span class="text-accent">##</span> explore
				</h2>
			</div>
			<div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
				<a
					href={withBase('/blog/')}
					class="group rounded-lg border border-edge/70 bg-night/40 p-4 no-underline transition-colors hover:border-accent/40"
				>
					<span class="block font-mono text-xs text-accent">./blog</span>
					<span class="mt-2 block text-sm text-slate-200 group-hover:text-accent">全部文章</span>
					<span class="mt-1 block text-xs leading-5 text-slate-500">按时间浏览全部记录</span>
				</a>
				<a
					href={withBase('/tags/')}
					class="group rounded-lg border border-edge/70 bg-night/40 p-4 no-underline transition-colors hover:border-accent/40"
				>
					<span class="block font-mono text-xs text-accent">#tags</span>
					<span class="mt-2 block text-sm text-slate-200 group-hover:text-accent">浏览标签</span>
					<span class="mt-1 block text-xs leading-5 text-slate-500">沿主题继续阅读</span>
				</a>
				<button
					type="button"
					data-search-open
					aria-haspopup="dialog"
					aria-keyshortcuts="Control+K Meta+K"
					class="group rounded-lg border border-edge/70 bg-night/40 p-4 text-left transition-colors hover:border-accent/40"
				>
					<span class="block font-mono text-xs text-accent">grep</span>
					<span class="mt-2 block text-sm text-slate-200 group-hover:text-accent">站内搜索</span>
					<span class="mt-1 block text-xs leading-5 text-slate-500">
						<span data-search-shortcut>Ctrl</span> + K 任意页面可用
					</span>
				</button>
				<a
					href={withBase('/rss.xml')}
					class="group rounded-lg border border-edge/70 bg-night/40 p-4 no-underline transition-colors hover:border-accent/40"
				>
					<span class="block font-mono text-xs text-accent">rss.xml</span>
					<span class="mt-2 block text-sm text-slate-200 group-hover:text-accent">订阅更新</span>
					<span class="mt-1 block text-xs leading-5 text-slate-500">用阅读器跟进新文章</span>
				</a>
			</div>
		</div>
	</section>

	<section class="mt-12 rounded-xl border border-edge bg-panel/30 p-6">
		<div class="flex flex-wrap items-end justify-between gap-3 border-b border-edge pb-3">
			<h2 class="font-mono text-sm text-slate-400">
				<span class="text-accent">##</span> site_stack
			</h2>
			<span class="font-mono text-xs text-slate-600">static · no backend · no database</span>
		</div>
		<ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				stack.map((item) => (
					<li class="rounded-lg border border-edge/70 bg-night/40 p-4">
						<p class="font-mono text-xs text-accent">{item.key}</p>
						<p class="mt-2 text-sm text-slate-200">{item.label}</p>
						<p class="mt-1 text-xs leading-5 text-slate-500">{item.detail}</p>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>