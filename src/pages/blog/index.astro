---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description="全部博客文章">
	<header class="border-b border-edge pb-8">
		<p class="font-mono text-sm text-accent">// archive</p>
		<h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">全部文章</h1>
		<p class="mt-3 font-mono text-sm text-slate-500">
			<span class="text-accent">$</span> ls ./posts | wc -l
			<span class="mx-2 text-slate-600">→</span>
			{posts.length} 篇
		</p>
	</header>
	<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
		{posts.map((post, i) => <PostCard post={post} index={i + 1} />)}
	</div>
</BaseLayout>