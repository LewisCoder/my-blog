---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_REPO } from '../consts';
import { withBase } from '../utils/url';
---

<BaseLayout title="关于本站" description="关于本站">
	<div class="mx-auto max-w-3xl">
		<p class="font-mono text-sm text-accent">// about_site</p>
		<h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">关于本站</h1>
		<div class="prose prose-invert prose-emerald mt-8 max-w-none prose-a:no-underline prose-p:leading-8 hover:prose-a:underline">
			<p>
				这是一个用来记录学习笔记、技术实践与生活随想的个人博客，主要关注 Java 后端、系统设计与工程实践。
			</p>
			<h2>这里有什么</h2>
			<ul>
				<li>按时间整理的技术文章与实践记录</li>
				<li>按标签聚合的主题索引，方便沿着一条线索继续读下去</li>
				<li>在任意页面按 <code>Ctrl/⌘ + K</code> 唤出的站内搜索浮层</li>
				<li>可直接用阅读器订阅的 <a href={withBase('/rss.xml')}>RSS 输出</a></li>
			</ul>
			<h2>关于这个博客</h2>
			<ul>
				<li>使用 <a href="https://astro.build/">Astro</a> 构建，静态输出，访问快速</li>
				<li>样式由 <a href="https://tailwindcss.com/">Tailwind CSS</a> 驱动</li>
				<li>文章用 Markdown 编写，保存在 <code>src/content/blog/</code> 目录，无需数据库</li>
				<li>搜索索引在构建期生成，匹配全部在浏览器本地完成</li>
			</ul>
			<h2>订阅与联系</h2>
			<p>
				可以通过 <a href={withBase('/rss.xml')}>RSS</a> 订阅更新，也可以在
				<a href={SITE_REPO}>GitHub 仓库</a>中查看本站源码或提交 issue。
			</p>
		</div>
	</div>
</BaseLayout>