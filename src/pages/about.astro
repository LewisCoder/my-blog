---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_AUTHOR, SITE_ROLE } from '../consts';
---

<BaseLayout title="关于" description={`关于 ${SITE_AUTHOR}`}>
	<div class="mx-auto max-w-3xl">
		<p class="font-mono text-sm text-accent">// about_me</p>
		<h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">关于我</h1>
		<div class="prose prose-invert prose-emerald mt-8 max-w-none prose-a:no-underline prose-p:leading-8 hover:prose-a:underline">
			<p>
				你好，我是 {SITE_AUTHOR}，一名 {SITE_ROLE}。这里是我的个人博客，用来记录学习笔记、技术实践和生活随想。
			</p>
			<h2>关于这个博客</h2>
			<ul>
				<li>使用 <a href="https://astro.build/">Astro</a> 构建，静态输出，访问快速</li>
				<li>样式由 <a href="https://tailwindcss.com/">Tailwind CSS</a> 驱动</li>
				<li>文章用 Markdown 编写，保存在 <code>src/content/blog/</code> 目录，无需数据库</li>
			</ul>
			<h2>联系方式</h2>
			<p>可以把这里换成你的 GitHub、邮箱或其他社交账号链接。</p>
			<ul>
				<li>GitHub：<a href="https://github.com/">github.com/your-name</a></li>
				<li>邮箱：<a href="mailto:your@email.com">your@email.com</a></li>
			</ul>
		</div>
	</div>
</BaseLayout>