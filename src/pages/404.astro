---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在">
	<div class="flex flex-col items-center py-24 text-center font-mono">
		<p class="text-sm text-red-400">fatal: page not found</p>
		<p class="mt-6 text-7xl font-bold tracking-tighter text-white sm:text-8xl">404</p>
		<p class="mt-4 text-sm text-slate-500"># 你访问的页面可能已被移动或删除。</p>
		<a
			href={withBase('/')}
			class="mt-10 rounded-lg border border-edge px-5 py-2.5 text-sm text-slate-300 no-underline transition hover:border-accent/40 hover:text-accent"
		>
			$ cd /home
		</a>
	</div>
</BaseLayout>