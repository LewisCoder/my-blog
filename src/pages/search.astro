---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAX_QUERY_LENGTH } from '../scripts/search-core.js';
---

<BaseLayout title="搜索" description="在全部文章中搜索内容">
	<header class="border-b border-edge pb-8">
		<p class="font-mono text-sm text-accent">// search</p>
		<h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">搜索</h1>
		<p class="mt-3 font-mono text-sm text-slate-500">
			<span class="text-accent">$</span> grep "查询词" ./posts
		</p>
	</header>

	<section class="mt-8" aria-labelledby="search-heading">
		<h2 id="search-heading" class="sr-only">站内搜索</h2>
		<label for="search-input" class="sr-only">搜索文章</label>

		<div class="overflow-hidden rounded-xl border border-edge bg-panel/60 backdrop-blur">
			<div
				class="flex items-center gap-2 border-b border-edge/80 px-4 py-2.5 font-mono text-[11px] text-slate-600"
				aria-hidden="true"
			>
				<span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
				<span class="h-2.5 w-2.5 rounded-full bg-amber-300/70"></span>
				<span class="h-2.5 w-2.5 rounded-full bg-accent/70"></span>
				<span class="ml-2">~/posts — search</span>
				<span class="ml-auto">UTF-8</span>
			</div>
			<div class="flex items-center gap-2 px-4 py-4 font-mono text-sm">
				<span class="text-accent" aria-hidden="true">$</span>
				<span class="text-slate-500" aria-hidden="true">grep</span>
				<span class="text-slate-600" aria-hidden="true">"</span>
				<input
					id="search-input"
					type="search"
					name="q"
					maxlength={MAX_QUERY_LENGTH}
					autocomplete="off"
					spellcheck="false"
					placeholder="输入查询词…"
					class="min-w-0 flex-1 bg-transparent text-slate-100 placeholder:text-slate-600 focus:outline-none"
				/>
				<span class="text-slate-600" aria-hidden="true">"</span>
				<span class="text-slate-500" aria-hidden="true">./posts</span>
			</div>
		</div>

		<p id="search-status" class="mt-6 font-mono text-xs text-slate-500" role="status" aria-live="polite"></p>
		<ol id="search-results" class="mt-4 space-y-3"></ol>
	</section>

	<script>
		import '../scripts/blog-search';
	</script>
</BaseLayout>