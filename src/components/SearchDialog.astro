---
import { MAX_QUERY_LENGTH } from '../scripts/search-core.js';
---

<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-dialog-title" data-search-dialog>
	<div class="overflow-hidden rounded-xl border border-edge bg-panel shadow-[0_32px_90px_-24px_rgba(0,0,0,0.95)]">
		<h2 id="search-dialog-title" class="sr-only">站内搜索</h2>

		<div
			class="flex items-center gap-2 border-b border-edge/80 bg-panel-2/60 px-4 py-2.5 font-mono text-[11px] text-slate-600"
			aria-hidden="true"
		>
			<span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-amber-300/70"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-accent/70"></span>
			<span class="ml-2">~/posts — search</span>
			<button
				type="button"
				data-search-close
				class="ml-auto rounded border border-edge px-1.5 py-0.5 font-mono text-[10px] text-slate-500 transition-colors hover:border-accent/40 hover:text-accent"
				aria-label="关闭搜索"
			>
				esc
			</button>
		</div>

		<div class="flex items-center gap-2 px-4 py-3 font-mono text-sm">
			<span class="text-accent" aria-hidden="true">$</span>
			<span class="text-slate-500" aria-hidden="true">grep</span>
			<span class="text-slate-600" aria-hidden="true">"</span>
			<label for="search-input" class="sr-only">搜索文章</label>
			<input
				id="search-input"
				type="search"
				name="q"
				maxlength={MAX_QUERY_LENGTH}
				autocomplete="off"
				spellcheck="false"
				placeholder="搜索标题、标签与正文…"
				aria-controls="search-results"
				aria-describedby="search-status"
				class="min-w-0 flex-1 bg-transparent text-slate-100 placeholder:text-slate-600 focus:outline-none"
			/>
			<span class="text-slate-600" aria-hidden="true">"</span>
			<span class="text-slate-500" aria-hidden="true">./posts</span>
		</div>

		<p
			id="search-status"
			class="border-t border-edge/60 px-4 py-2.5 font-mono text-xs text-slate-500"
			role="status"
			aria-live="polite"
			aria-atomic="true"
		></p>
		<ol
			id="search-results"
			class="max-h-[52vh] space-y-1 overflow-y-auto px-2 pb-2"
			aria-label="搜索结果"
		></ol>

		<div
			class="flex items-center justify-between gap-3 border-t border-edge/60 px-4 py-2 font-mono text-[10px] text-slate-600"
			aria-hidden="true"
		>
			<span>↵ 打开 · ↑↓ 选择</span>
			<span class="hidden sm:inline"><span data-search-shortcut>Ctrl</span> K 切换 · esc 关闭</span>
		</div>
	</div>
</dialog>

<script>
	import '../scripts/search-dialog';
</script>