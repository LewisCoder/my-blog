---
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils/url';
import HeaderLink from './HeaderLink.astro';
---

<header class="sticky top-0 z-30 border-b border-edge/80 bg-night/80 backdrop-blur-xl">
	<div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
		<a href={withBase('/')} class="group flex items-center gap-2 font-mono text-sm no-underline">
			<span class="text-accent">&gt;_</span>
			<span class="font-medium text-slate-300 transition-colors group-hover:text-white">
				{SITE_TITLE}
			</span>
			<span class="ml-0.5 inline-block h-3.5 w-1.5 animate-blink bg-accent/70"></span>
		</a>
		<nav class="flex items-center gap-1 sm:gap-2">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog/">文章</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
			<a
				href="https://github.com/"
				target="_blank"
				rel="noreferrer"
				class="ml-1 hidden rounded-md border border-edge px-3 py-1.5 font-mono text-[13px] text-slate-400 no-underline transition-colors hover:border-accent/40 hover:text-accent sm:block"
			>
				github ↗
			</a>
		</nav>
	</div>
</header>